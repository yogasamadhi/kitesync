{
  "name": "@kitesync/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json --incremental --tsBuildInfoFile dist/.tsbuildinfo",
    "dev": "tsc -p tsconfig.json --incremental --tsBuildInfoFile dist/.tsbuildinfo --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16"
  }
}
