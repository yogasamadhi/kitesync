{
  "name": "kitesync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "bootstrap": "bun install --frozen-lockfile && bun run dev:certs && bun run syncthing:verify",
    "build": "bun run --workspaces --if-present build",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "check": "bun run format:check && bun run lint && bun run boundaries:check && bun run migrations:check && bun run typecheck && bun run test",
    "predev": "bun run --filter @kitesync/contracts build && bun run --filter @kitesync/ui build && bun run --filter @kitesync/api-client build",
    "dev": "bun run --parallel --filter @kitesync/contracts --filter @kitesync/ui --filter @kitesync/api-client --filter @kitesync/control-plane --filter @kitesync/web --filter @kitesync/desktop-runtime --filter @kitesync/desktop dev",
    "dev:all": "bun run run.ts",
    "dev:certs": "node scripts/generate-dev-certs.mjs",
    "dev:deps": "node scripts/start-dev-deps.mjs",
    "dev:logs": "docker compose -f deploy/compose/docker-compose.yml logs -f",
    "dev:reset": "node scripts/reset-dev.mjs",
    "dev:stop": "docker compose -f deploy/compose/docker-compose.yml down",
    "debug": "bun run run.ts --inspect",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "migrations:check": "node scripts/check-migration-checksums.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "syncthing:verify": "node scripts/verify-syncthing-release.mjs",
    "updates:sign": "node scripts/sign-update-manifest.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.scripts.json --noEmit && bun run --workspaces --if-present typecheck"
  },
  "overrides": {
    "@electron/get": "3.1.0"
  },
  "trustedDependencies": [
    "argon2",
    "cpu-features",
    "electron",
    "electron-winstaller",
    "esbuild",
    "protobufjs",
    "ssh2"
  ],
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.1",
    "@testcontainers/postgresql": "^11.6.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "openpgp": "^6.2.2",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
