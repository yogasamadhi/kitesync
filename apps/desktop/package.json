{
  "name": "@kitesync/desktop",
  "version": "1.0.0",
  "description": "KiteSync server-centric LAN file synchronization desktop client",
  "author": "KiteSync",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "prebuild": "bun run --filter @kitesync/contracts build && bun run --filter @kitesync/ui build",
    "clean:main": "bun -e \"require('node:fs').rmSync('dist/main',{recursive:true,force:true})\"",
    "build": "bun run clean:main && tsc -p tsconfig.main.json && vite build",
    "dev": "bun run clean:main && concurrently -k -n renderer,main,electron \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on tcp:5174 file:dist/main/main.js file:dist/main/preload.cjs && electron .\"",
    "dist": "bun run build && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@kitesync/contracts": "workspace:*",
    "@kitesync/ui": "workspace:*",
    "electron-updater": "^6.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.7",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.kitesync.desktop",
    "productName": "KiteSync",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../desktop-runtime/dist",
        "to": "runtime"
      },
      {
        "from": "build/update-public-key.pem",
        "to": "update-public-key.pem"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "extraResources": [
        {
          "from": "../../vendor/syncthing/bin/win32-${arch}",
          "to": "syncthing"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "extraResources": [
        {
          "from": "../../vendor/syncthing/bin/darwin-${arch}",
          "to": "syncthing"
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "extraResources": [
        {
          "from": "../../vendor/syncthing/bin/linux-${arch}",
          "to": "syncthing"
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network"
    }
  }
}
