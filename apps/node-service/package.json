{
  "name": "@kitesync/node-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kitesync": "dist/main.js"
  },
  "scripts": {
    "prebuild": "bun run --filter @kitesync/contracts build",
    "build": "bun -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json --noEmit && bun build src/main.ts --target=bun --format=esm --outdir=dist",
    "dev": "bun --no-env-file src/dev-supervisor.ts",
    "package": "bun --no-env-file ../../scripts/package-node.mjs",
    "start": "bun --no-env-file dist/main.js serve",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@kitesync/contracts": "workspace:*",
    "@sinclair/typebox": "^0.34.41",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  }
}
