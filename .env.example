# 仅列出可显式传给进程/容器的环境变量。KiteSync 不自动读取此文件。
KITESYNC_STATE_DIR=.kitesync-dev/node
KITESYNC_UI_HOST=127.0.0.1
KITESYNC_UI_PORT=3210
KITESYNC_SYNCTHING_GUI_PORT=8385
KITESYNC_SYNCTHING_BINARY=
KITESYNC_WEB_ROOT=

# 原生 headless 首次启动使用只读 secret file；不支持明文密码命令行参数。
KITESYNC_ADMIN_PASSWORD_FILE=

# 以下两个变量只供可选 Compose 在宿主机解析。
KITESYNC_ADMIN_PASSWORD_SECRET_FILE=./admin-password.txt
KITESYNC_DATA_DIR=./data

# 可选固定数据选择根。API 只返回短期句柄，不把绝对路径发送给其他 peer。
KITESYNC_DIRECTORY_ROOTS=/data

# 只影响从固定源码构建 Syncthing，module 仍由 go.sum 校验。
GOPROXY=https://proxy.golang.org,direct
